{
  "editor.wordWrap": "on",
  "files.exclude": {
    "build/**": true
  },
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 1000,
  "latex-workshop.latex.recipe.default": "latexmk (fast xelatex)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (fast xelatex)",
      "tools": [
        "latexmk-xelatex"
      ]
    },
    {
      "name": "latexmk watch",
      "tools": [
        "latexmk-watch"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-file-line-error",
        "-halt-on-error",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-outdir=build",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-watch",
      "command": "latexmk",
      "args": [
        "-pvc",
        "-xelatex",
        "-file-line-error",
        "-halt-on-error",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-outdir=build",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true
}
